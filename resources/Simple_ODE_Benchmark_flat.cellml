  <component name="parameters">
    <variable name="x_init_benchmark" units="dimensionless" initial_value="0" interface="public"/>
    <variable name="y_init_benchmark" units="dimensionless" initial_value="0" interface="public"/>
    <variable name="p_benchmark" units="dimensionless" initial_value="1" interface="public"/>
    <variable name="q_benchmark" units="dimensionless" initial_value="1" interface="public"/>
  </component>
  <component name="parameters_global"/>
  <component name="environment">
    <variable name="time" units="second" interface="public"/>
  </component>
  <component name="benchmark_module">
    <variable name="t" units="second" interface="public"/>
    <variable name="x_init" units="dimensionless" interface="public"/>
    <variable name="y_init" units="dimensionless" interface="public"/>
    <variable name="p" units="dimensionless" interface="public"/>
    <variable name="q" units="dimensionless" interface="public"/>
    <variable name="x" units="dimensionless" initial_value="x_init" interface="public"/>
    <variable name="y" units="dimensionless" initial_value="y_init" interface="public"/>
    <math xmlns="http://www.w3.org/1998/Math/MathML" xmlns:cellml="http://www.cellml.org/cellml/2.0#">
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>x</ci>
        </apply>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">1</cn>
            </apply>
            <ci>x</ci>
          </apply>
          <ci>p</ci>
        </apply>
      </apply>
      <apply>
        <eq/>
        <apply>
          <diff/>
          <bvar>
            <ci>t</ci>
          </bvar>
          <ci>y</ci>
        </apply>
        <apply>
          <plus/>
          <apply>
            <times/>
            <apply>
              <minus/>
              <cn cellml:units="dimensionless">3</cn>
            </apply>
            <ci>y</ci>
          </apply>
          <ci>q</ci>
        </apply>
      </apply>
    </math>
  </component>
  <component name="terminal_venous_connection"/>
  <component name="generic_junction_connection"/>
  <component name="sum_blood_volume"/>
  <component name="benchmark">
    <variable name="x_init" units="dimensionless" interface="public"/>
    <variable name="y_init" units="dimensionless" interface="public"/>
    <variable name="p" units="dimensionless" interface="public"/>
    <variable name="q" units="dimensionless" interface="public"/>
    <variable name="x" units="dimensionless" interface="public"/>
    <variable name="y" units="dimensionless" interface="public"/>
  </component>
  <component name="global"/>
  <connection component_1="parameters" component_2="benchmark_module">
    <map_variables variable_1="x_init_benchmark" variable_2="x_init"/>
    <map_variables variable_1="y_init_benchmark" variable_2="y_init"/>
    <map_variables variable_1="p_benchmark" variable_2="p"/>
    <map_variables variable_1="q_benchmark" variable_2="q"/>
  </connection>
  <connection component_1="environment" component_2="benchmark_module">
    <map_variables variable_1="time" variable_2="t"/>
  </connection>
  <connection component_1="benchmark_module" component_2="benchmark">
    <map_variables variable_1="x_init" variable_2="x_init"/>
    <map_variables variable_1="y_init" variable_2="y_init"/>
    <map_variables variable_1="p" variable_2="p"/>
    <map_variables variable_1="q" variable_2="q"/>
    <map_variables variable_1="x" variable_2="x"/>
    <map_variables variable_1="y" variable_2="y"/>
  </connection>
</model>
