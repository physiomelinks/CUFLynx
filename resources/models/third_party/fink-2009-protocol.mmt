[[model]]
name: Fink-2009
author: Michael Clerx
desc: """
Protocol as given in [1].

Use Ctrl-P or View > Preview Protocol to inspect the protocol.

[1] Markov models for ion channels; versatility vs. identiability and speed
    Fink, Noble (2009) Philosophical transactions of the royal society A

"""
[engine]
time = 0 bind time

[[protocol]]
# From the paper
# --------------
# Shortened protocol (figure 3b); (i) activation and inactivation: from a
# holding potential of -80 mV (600 ms) to -60, -40 or +20 mV for 1000 ms and
# back to -80 mV; (ii) deactivation: from a holding potential of +60 mV (1000
# ms) to -100, -70 or -40 mV for 1000 ms and back to holding potential; (iii)
# reactivation: from a holding potential of +60 mV (1000 ms), a voltage step to
# -100 or -80 mV for 10 ms, then up to +40 mV for 100 ms and down to -60 mV for
# 200 ms and back to the holding potential.
#
# From the accompanying source
# ----------------------------
# Vhold = -80; Vclamp = [];
# % activation & inactivation
# for i = [1 2 5];  Vclamp = [Vclamp; 500 Vhold; 1000 Vhold+i*20; 100 Vhold]; end
# % deactivation
# for i = 1:3; Vclamp = [Vclamp; 1000 60; 1000 -130+i*30]; end
# % reactivation
# for i = 1:2;  Vclamp = [Vclamp; 1000 60; 10 -120+i*20; 100 40; 200 -60]; end
#
# Level Start   Length  Period  Multiplier
-80     0       500     0       0
-60     500     1000    0       0
-80     1500    600     0       0
-40     2100    1000    0       0
-80     3100    600     0       0
+20     3700    1000    0       0
-80     4700    100     0       0
+60     4800    1000    0       0
-100    5800    1000    0       0
+60     6800    1000    0       0
-70     7800    1000    0       0
+60     8800    1000    0       0
-40     9800    1000    0       0
+60     10800   1000    0       0
-100    11800   10      0       0
+40     11810   100     0       0
-60     11910   200     0       0
+60     12110   1000    0       0
-80     13110   10      0       0
+40     13120   100     0       0
-60     13220   200     0       0

[[script]]
import myokit
import numpy as np
import matplotlib.pyplot as plt

# Load protocol
p = get_protocol()

# Test if unbroken sequence of steps
p.is_unbroken_sequence_exception()

# Get duration of protocol
t0 = 0
t1 = p.characteristic_time()

# Show a preview of the protocol
d = p.log_for_interval(t0, t1, for_drawing=True)
plt.figure()
plt.plot(d['time'], d['pace'])
plt.show()

# Set sampling rate (0.1 ms --> 10 kHz)
r = 0.1

# Evenly spaced times from t0 to t1
time = np.arange(t0, t1, r)

# Get log with time and pacing variable
log = p.log_for_times(time)

# Save protocol as ATF file suitable for Axon software
if False:
    from myokit.formats import axon
    axon.save_atf(log, 'fink-10kHz.atf')

# Save protocol as text file suitable for WinWCP
if False:
    # WinWCP interprets the voltages as relative to a resting potential.
    # Define a holding potential
    vhold = -120
    # Update the pacing signal (using numpy)
    log = log.npview()
    log['pace'] -= vhold
    # Save to disk as a text file WinWCP can read
    log.save_csv('fink-10kHz.txt',
        order=['time', 'pace'],     # Fix the order of the output
        precision=None,             # Don't format the numbers
        delimiter='\t',             # Use tabs instead of commas
        header=False)               # Don't add a header

