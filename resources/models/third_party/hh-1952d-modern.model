/*
This file was generated by Myokit.

author: Michael Clerx
desc: Myokit implementation of the model described in Hodgkin and Huxley's 1952
paper [1], updated to use modern conventions.

The modernization consisted of mirroring the gate functions around the
point V=-75 to obtain the usual direction of depolarization. Additionally,
the formulation V = E - Er was dropped and V is taken to be the action
potential, not the difference in action potential.

[1] A quantitative description of membrane current and its application to
conduction and excitation in nerve.
Hodgkin, Huxley, 1952d, Journal of Physiology
name: HodgkinHuxley1952d_Modern

*/

V; .nodal(); .external(Vm);
Iion; .nodal(); .external();

V_init = -75.0;
n_init = 0.317;
m_init = 0.05;
h_init = 0.595;

// leak
Eleak = -64.387;
g_max_1 = 0.3;
i_1 = g_max_1 * (V - Eleak);

// membrane
A = 100.0;
Vhold = -60.0;
i_stim = (V - Vhold) * A * 0.0;

// potassium
Ek = -87.0;
g_max_2 = 36.0;
i_2 = g_max_2 * pow(n, 4.0) * (V - Ek);
alpha_n = 0.01 * (-V - 65.0) / (expm1((-V - 65.0) / 10.0));
beta_n = 0.125 * exp((-V - 75.0) / 80.0);

// sodium
ENa = 40.0;
g_max_3 = 120.0;
alpha_h = 0.07 * exp((-V - 75.0) / 20.0);
beta_h = 1.0 / (exp((-V - 45.0) / 10.0) + 1.0);
i_3 = g_max_3 * pow(m, 3.0) * h * (V - ENa);
alpha_m = 0.1 * (-V - 50.0) / (expm1((-V - 50.0) / 10.0));
beta_m = 4.0 * exp((-V - 75.0) / 18.0);

// Sum of currents
Iion = i_3 + i_1 + i_2 + i_stim;

// Trace all currents and state variables
group {
  i_3;
  i_1;
  i_2;
  i_stim;
  V;
  n;
  m;
  h;
}.trace();

// Parameters
group {
  Eleak;
  g_max_1;
  A;
  Vhold;
  Ek;
  g_max_2;
  ENa;
  g_max_3;
}.param();

