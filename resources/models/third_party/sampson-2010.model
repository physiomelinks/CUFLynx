  C3Kv43;
  OKv43;
  CI0Kv43;
  CI1Kv43;
  CI2Kv43;
  CI3Kv43;
  OIKv43;
  C1Herg;
  C2Herg;
  C3Herg;
  OHerg;
  IHerg;
}.method(cvode);

