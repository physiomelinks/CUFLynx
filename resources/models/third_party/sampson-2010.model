CI0Kv43_to_CI1Kv43 = 4.0 * b1Kv43 * ito_alpha_act43;
diff_CI1Kv43 = a2_26 - a1_29;
a1_29 = (CI1Kv43_to_CI2Kv43 + CI1Kv43_to_C1Kv43 + CI1Kv43_to_CI0Kv43) * CI1Kv43;
a2_26 = CI2Kv43_to_CI1Kv43 * CI2Kv43 + C1Kv43_to_CI1Kv43 * C1Kv43 + CI0Kv43_to_CI1Kv43 * CI0Kv43;
CI1Kv43_to_C1Kv43 = ito_alpha_inact43 / b1Kv43;
CI1Kv43_to_CI0Kv43 = ito_beta_act43 / f1Kv43;
CI1Kv43_to_CI2Kv43 = 3.0 * b2Kv43 * ito_alpha_act43 / b1Kv43;
diff_CI2Kv43 = a2_27 - a1_30;
a1_30 = (CI2Kv43_to_CI3Kv43 + CI2Kv43_to_C2Kv43 + CI2Kv43_to_CI1Kv43) * CI2Kv43;
a2_27 = CI3Kv43_to_CI2Kv43 * CI3Kv43 + C2Kv43_to_CI2Kv43 * C2Kv43 + CI1Kv43_to_CI2Kv43 * CI1Kv43;
CI2Kv43_to_C2Kv43 = ito_alpha_inact43 / b2Kv43;
CI2Kv43_to_CI1Kv43 = 2.0 * f1Kv43 * ito_beta_act43 / f2Kv43;
CI2Kv43_to_CI3Kv43 = 2.0 * b3Kv43 * ito_alpha_act43 / b2Kv43;
diff_CI3Kv43 = a2_28 - a1_31;
a1_31 = (CI3Kv43_to_OIKv43 + CI3Kv43_to_C3Kv43 + CI3Kv43_to_CI2Kv43) * CI3Kv43;
a2_28 = OIKv43_to_CI3Kv43 * OIKv43 + C3Kv43_to_CI3Kv43 * C3Kv43 + CI2Kv43_to_CI3Kv43 * CI2Kv43;
CI3Kv43_to_C3Kv43 = ito_alpha_inact43 / b3Kv43;
CI3Kv43_to_CI2Kv43 = 3.0 * f2Kv43 * ito_beta_act43 / f3Kv43;
CI3Kv43_to_OIKv43 = b4Kv43 * ito_alpha_act43 / b3Kv43;
Ito1 = GKv43 * OKv43 * (V - EK);
GKv43 = 1.52138159999999995e-01;
diff_OIKv43 = a2_29 - a1_32;
a1_32 = (OIKv43_to_OKv43 + OIKv43_to_CI3Kv43) * OIKv43;
a2_29 = OKv43_to_OIKv43 * OKv43 + CI3Kv43_to_OIKv43 * CI3Kv43;
OIKv43_to_CI3Kv43 = 4.0 * f3Kv43 * ito_beta_act43 / f4Kv43;
OIKv43_to_OKv43 = ito_alpha_inact43 / b4Kv43;
diff_OKv43 = a2_30 - a1_33;
a1_33 = (OKv43_to_C3Kv43 + OKv43_to_OIKv43) * OKv43;
a2_30 = C3Kv43_to_OKv43 * C3Kv43 + OIKv43_to_OKv43 * OIKv43;
OKv43_to_C3Kv43 = 4.0 * ito_beta_act43;
OKv43_to_OIKv43 = f4Kv43 * ito_beta_inact43;
aaKv43 = 0.028983;
aiKv43 = 3.73015999999999994e-04;
ito_alpha_act43 = alphaa0Kv43 * exp(aaKv43 * V);
ito_alpha_inact43 = alphai0Kv43 * exp(-aiKv43 * V);
alphaa0Kv43 = 0.543708;
alphai0Kv43 = 0.0498424;
b1Kv43 = 6.77348;
b2Kv43 = 1.56212705152000009e+01;
b3Kv43 = 2.87532603313000017e+01;
b4Kv43 = 5.24576206679000052e+02;
baKv43 = 0.0468437;
ito_beta_act43 = betaa0Kv43 * exp(-baKv43 * V);
ito_beta_inact43 = betai0Kv43 * exp(biKv43 * V);
betaa0Kv43 = 0.080185;
betai0Kv43 = 8.19481999999999958e-04;
biKv43 = 5.374e-08;
f1Kv43 = 1.8936;
f2Kv43 = 1.42246474559999996e+01;
f3Kv43 = 1.58574378389000003e+02;
f4Kv43 = 1.42936645351000010e+02;

// membrane
i_ion = a1_34 + a2_31 + a3_4;
a1_34 = INa + INa1 + ICa + ICa32 + ICaK + IKr + IKs + IHCN;
a2_31 = IK1 + INaCa + INaK + Ito1 + Isus;
a3_4 = IpCa;
i_stim = 0.0 * amplitude;
amplitude = -100.0;

// nav11
diff_BC1na1 = BOna1 * b13_1 + BIFna1 * aa3 + BC2na1 * a12_1 + C1na1 * mu1_1 - BC1na1 * (a13_1 + bb3 + b12_1 + mu2_1);
diff_BC2na1 = BC1na1 * b12_1 + BC3na1 * a11_1 + C2na1 * mu1_1 - BC2na1 * (a12_1 + b11_1 + mu2_1);
diff_BC3na1 = BC2na1 * b11_1 + C3na1 * mu1_1 - BC3na1 * (a11_1 + mu2_1);
diff_BIFna1 = BC1na1 * bb3 + BOna1 * aa2 - BIFna1 * (aa3 + bb2);
diff_BOna1 = BIFna1 * bb2 + BC1na1 * a13_1 + Ona1 * mu1_1 - BOna1 * (aa2 + b13_1 + mu2_1);
diff_C1na1 = IFna1 * a3_5 + BC1na1 * mu2_1 + Ona1 * b13_1 + C2na1 * a12_1 - C1na1 * (a13_1 + b3_1 + mu1_1 + b12_1);
diff_C2na1 = IC2na1 * a3_5 + BC2na1 * mu2_1 + C1na1 * b12_1 + C3na1 * a11_1 - C2na1 * (a12_1 + b3_1 + mu1_1 + b11_1);
diff_C3na1 = IC3na1 * a3_5 + BC3na1 * mu2_1 + C2na1 * b11_1 - C3na1 * (a11_1 + b3_1 + mu1_1);
GNa1 = 9.0;
diff_IC2na1 = IFna1 * b12_1 + C2na1 * b3_1 + IC3na1 * a11_1 - IC2na1 * (a12_1 + a3_5 + b11_1);
diff_IC3na1 = IC2na1 * b11_1 + C3na1 * b3_1 - IC3na1 * (a11_1 + a3_5);
diff_IFna1 = IS1na1 * b4_1 + Ona1 * a2_32 + IC2na1 * a12_1 + C1na1 * b3_1 - IFna1 * (a4_2 + b2_3 + b12_1 + a3_5);
INa1 = GNa1 * (Ona1 + BOna1) * (V - ENa);
diff_IS1na1 = IS2na1 * b5_1 + IFna1 * a4_2 - IS1na1 * (a5_2 + b4_1);
diff_IS2na1 = IS1na1 * a5_2 - IS2na1 * b5_1;
Ona1 = 1.0 - BC1na1 - BC2na1 - BC3na1 - BIFna1 - BOna1 - C1na1 - C2na1 - C3na1 - IC2na1 - IC3na1 - IFna1 - IS1na1 - IS2na1;
a11_1 = 2.802 / (0.21 * exp(-V / 17.0) + 0.23 * exp(-V / 150.0));
a12_1 = 2.802 / (0.23 * exp(-V / 15.0) + 0.25 * exp(-V / 150.0));
a13_1 = 2.802 / (0.25 * exp(-V / 12.0) + 0.27 * exp(-V / 150.0));
a2_32 = 9.178 * exp(V / 29.68) / 4.5;
a3_5 = 3.79329999999999996e-07 * exp(-V / 7.6) * 3.0;
a4_2 = a2_32 / 100.0 * 1.5 * 0.285;
a5_2 = a2_32 / 95000.0 * 80.0;
aa2 = 0.0;
aa3 = 0.0;
b11_1 = 0.4 * exp(-V / 20.3);
b12_1 = 0.4 * exp(-(V - 5.0) / 20.3);
b13_1 = 0.4 * exp(-(V - 10.0) / 20.3) / 4.5;
b2_3 = a3_5 * a2_32 * a13_1 / (b3_1 * b13_1);
b3_1 = 0.0084 + 2e-05 * V;
b4_1 = a3_5 / 5.0;
b5_1 = a3_5 / 30.0 / 10.0;
bb2 = 0.0;
bb3 = 0.0;
mu1_1 = 4.3e-08;
mu2_1 = 0.0003;

// nav15
diff_BC1 = -BC1 * (a13_2 + b12_2 + mu2_2) + BO * b13_2 + BC2 * a12_2 + C1_2 * mu1_2;
diff_BC2 = -BC2 * (a12_2 + b11_2 + mu2_2) + BC1 * b12_2 + BC3 * a11_2 + C2_2 * mu1_2;
diff_BC3 = -BC3 * (a11_2 + mu2_2) + BC2 * b11_2 + C3_2 * mu1_2;
diff_BO = -BO * (b13_2 + mu2_2) + BC1 * a13_2 + O * mu1_2;
diff_C1_2 = -C1_2 * (a13_2 + b3_2 + mu1_2 + b12_2) + IF * a3_6 + BC1 * mu2_2 + O * b13_2 + C2_2 * a12_2;
diff_C2_2 = -C2_2 * (a12_2 + b3_2 + mu1_2 + b11_2) + IC2 * a3_6 + BC2 * mu2_2 + C1_2 * b12_2 + C3_2 * a11_2;
diff_C3_2 = -C3_2 * (a11_2 + b3_2 + mu1_2) + IC3 * a3_6 + BC3 * mu2_2 + C2_2 * b11_2;
GNa = 35.0;
diff_IC2 = -IC2 * (a12_2 + a3_6 + b11_2) + IF * b12_2 + C2_2 * b3_2 + IC3 * a11_2;
diff_IC3 = -IC3 * (a11_2 + a3_6) + IC2 * b11_2 + C3_2 * b3_2;
diff_IF = -IF * (a4_3 + b2_4 + b12_2 + a3_6) + IS1 * b4_2 + O * a2_33 + IC2 * a12_2 + C1_2 * b3_2;
INa = GNa * (O + BO) * (V - ENa);
diff_IS1 = -IS1 * (a5_3 + b4_2) + IS2 * b5_2 + IF * a4_3;
diff_IS2 = -IS2 * b5_2 + IS1 * a5_3;
O = 1.0 - BC1 - BC2 - BC3 - BO - C1_2 - C2_2 - C3_2 - IC2 - IC3 - IF - IS1 - IS2;
a11_2 = 3.802 / (0.1027 * exp(-V / 17.0) + 0.2 * exp(-V / 150.0));
a12_2 = 3.802 / (0.1027 * exp(-V / 15.0) + 0.23 * exp(-V / 150.0));
a13_2 = 3.802 / (0.1027 * exp(-V / 12.0) + 0.25 * exp(-V / 150.0));
a2_33 = 9.178 * exp(V / 29.68);
a3_6 = 3.79329999999999996e-07 * exp(-V / 7.7);
a4_3 = a2_33 / 100.0;
a5_3 = a2_33 / 95000.0;
b11_2 = 0.1917 * exp(-V / 20.3);
b12_2 = 0.2 * exp(-(V - 5.0) / 20.3);
b13_2 = 0.22 * exp(-(V - 10.0) / 20.3);
b2_4 = a3_6 * a2_33 * a13_2 / (b3_2 * b13_2);
b3_2 = 0.0084 + 2e-05 * V;
b4_2 = a3_6;
b5_2 = a3_6 / 50.0;
mu1_2 = 4.3e-08;
mu2_2 = 0.0003;

// nernst
EK = RTF * log(Ko / Ki);
ENa = RTF * log(Nao / Nai);

// phys
Faraday = 96.5;
RTF = Rgas * Temp / Faraday;
Rgas = 8.315;
Temp = 310.0;
VFFRT = 1000.0 * Faraday * VFRT;
VFRT = V / RTF;

// potassium
IK_tot = IKr + IKs + IK1 + ICaK + 2.0 * IHCN / 3.0 + Isus + i_stim - 2.0 * INaK + Ito1;
diff_Ki = -a1_3 * IK_tot;

// ryr
diff_C1_RyR = dot_C1_RyR;
diff_C2_RyR = dot_C2_RyR;
Jrel = v1 * (O1_RyR + O2_RyR) * (CaJSR - CaSS);
v1 = 1.8;
diff_O1_RyR = -(dot_C1_RyR + dot_O2_RyR + dot_C2_RyR);
diff_O2_RyR = dot_O2_RyR;
dot_C1_RyR = -kaplus * a2_34 * C1_RyR + kaminus * O1_RyR;
a2_34 = pow(CaSS * 1000.0, ncoop);
kaminus = 0.576;
kaplus = 0.01215;
ncoop = 4.0;
dot_C2_RyR = kcplus * O1_RyR - kcminus * C2_RyR;
kcminus = 0.0008;
kcplus = 0.1;
dot_O2_RyR = kbplus * a1_35 * O1_RyR - kbminus * O2_RyR;
a1_35 = pow(CaSS * 1000.0, mcoop);
kbminus = 1.93;
kbplus = 0.00405;
mcoop = 3.0;

// serca
Jup = KSR * (vmaxf * fb - vmaxr * rb) / (1.0 + fb + rb);
KSR = 1.2;
Kfb = 0.000168;
Krb = 3.29;
Nfb = 1.2;
Nrb = 1.0;
fb = pow(Cai / Kfb, Nfb);
rb = pow(CaNSR / Krb, Nrb);
vmaxf = 7.48e-05;
vmaxr = 0.000318;

// sodium
INa_tot = INa + INa1 + IHCN / 3.0 + 3.0 * (INaCa + INaK);
diff_Nai = -a1_3 * INa_tot;

// Sum of currents
Iion = i_ion + i_stim;

// Markov model
group {
  BC1;
  BC2;
  BC3;
  BO;
  C1_2;
  C2_2;
  C3_2;
  IC2;
  IC3;
  IF;
  IS1;
  IS2;
}.method(markov_be);

// Markov model
group {
  hcn1;
  hcn2;
  hcn3;
  hcn4;
  hcn5;
  hcn6;
  hcn7;
  hcn8;
  hcn9;
}.method(markov_be);

// Markov model
group {
  BC1na1;
  BC2na1;
  BC3na1;
  BIFna1;
  BOna1;
  C1na1;
  C2na1;
  C3na1;
  IC2na1;
  IC3na1;
  IFna1;
  IS1na1;
  IS2na1;
}.method(markov_be);

// Solve non-HH and non-Markov states with CVODE
group {
  Nai;
  Ki;
  Cai;
  CaNSR;
  CaSS;
  CaJSR;
  C1_RyR;
  O1_RyR;
  C2_RyR;
