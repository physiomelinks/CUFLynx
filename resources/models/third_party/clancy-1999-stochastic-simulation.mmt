[[model]]
name: Clancy-1999-fitting
author: Michael Clerx
desc: """
Clancy 1999 SCN5A model suitable for parameter fitting.

Wild-type channel from Clancy 1999:

                     IF - IS
                   /  |
       C3 - C2 - C1 - O

[1] Linking a genetic defect to its cellular phenotype
    Colleen E. Clancy and Yoram Rudy
    1999, Nature

[2] http://www.cwru.edu/med/CBRTC/LRdOnline/markovina1999.htm

Note: The equations given in "Box 1" of the Nature publication appear to be
      incorrect. The first equation is missing a "-", and alpha3 contains a
      term 3.7933e-9, which is 3.7933e-10 in the version published online.

Max conductance : 18.5 [mS/cm^2]

Based on data from the following sources:

[3] Multiple-mechanisms of Na+ channel-linked long-QT syndrome.
    Dumaine, et al.
    1996, Circulation Research
[4] Multiple effects of the KPQ deletion on gating of human cardiac Na+
    channels expressed in mammalian cells.
    Chandra, Starmer & Grant
    1998, Am. J. Physiol
[5] Molecular mechanism for an inherited cardiac arrhythmia.
    Bennett, Yazawa, Makita, George
    1995, Nature

The midpoints of activation and inactivation correspond to those given in [4].
"""
# Initial conditions
ina.C3 = 0.99
ina.C2 = 0.01
ina.C1 = 0
ina.O  = 0
ina.IF = 0
ina.IS = 0

#
# Simulation engine variables
#
[engine]
time = 0 bind time

#
# Membrane potential
#
[membrane]
V = -140 bind pace
    label membrane_potential
    in [mV]

#
# Wild-type model from Clancy & Rudy 1999
# The equations were rewritten to have independent parameters.
#
[ina]
use membrane.V
p1 = 0.1027 / 3.802
p2 = 0.20 / 3.802
p3 = 0.23 / 3.802
p4 = 0.25 / 3.802
p5 = 1 / 17
p6 = 1 / 15
p7 = 1 / 12
p8 = 1 / 150
a11 = 1 / (p1 * exp(-V * p5) + p2 * exp(-V * p8))
a12 = 1 / (p1 * exp(-V * p6) + p3 * exp(-V * p8))
a13 = 1 / (p1 * exp(-V * p7) + p4 * exp(-V * p8))
q1 = 0.1917
q2 = 0.2
q3 = 0.22
q4 = 0
q5 = 5
q6 = 10
q7 = 1 / -20.3
b11 = q1 * exp((V - q4) * q7)
b12 = q2 * exp((V - q5) * q7)
b13 = q3 * exp((V - q6) * q7)
a2 = 9.178 * exp(V / 29.68)
b2 = (a3*a2*a13)/(b3*b13)
a3 = 3.7933e-10 * exp(-V / 5.2) # 3.7933e-7 * exp(-V / 7.7)
b3 = 0.0084 + 0.00002 * V
a4 = a2 / 100
b4 = a3
# Transition rates
dot(C3) = -C3 * (a11           ) + C2 * b11
dot(C2) = -C2 * (a12 + b11     ) + C1 * b12 + C3 * a11
dot(C1) = -C1 * (a13 + b12 + b3) + O  * b13 + C2 * a12 + IF * a3
dot(IF) = -IF * (a4  + b2  + a3) + IS * b4  + O  * a2  + C1 * b3
dot(IS) = -IS * (b4            ) + IF * a4
dot(O)  = -O  * (a2  + b13     ) + C1 * a13 + IF * b2
i = gmax * O * (V - E)
gmax = 18.5 [mS/cm^2]
E = 81 [mV]

[[script]]
import myokit
import myokit.lib.markov as markov
import matplotlib.pyplot as plt

#
# In this example, we demonstrate stochastic simulations of an ion current,
# performed using the `markov` module from Myokit's library.
#

# Extract a parametrizable Markov model from the AP model code.
m = get_model()
m = markov.LinearModel.from_component(m.get('ina'))

# Pre-pulse and holding potential
V1 = -140
V2 = -30
t_pre = 2
t_step = 5

# Number of channels
# Increasing this will cause the stochastic simulation to more closely resemble
# the analytical one
N = 250

# Create a figure
plt.figure()
plt.title('Stochastic and deterministic simulations of INa')

# Set up a discrete simulation
s = markov.DiscreteSimulation(m, nchannels=N)

# Pre-pulse
s.set_membrane_potential(V1)
d = s.run(t_pre)
# And step
s.set_membrane_potential(V2)
d = s.run(t_step, log=d)

# Get colors in the default color cycle
# and plot the simulated states
colors = plt.rcParams['axes.prop_cycle'].by_key()['color']
for i, state in enumerate(m.states()):
    plt.step(d.time(), d[state], label=state, color=colors[i])

# Now run analytical simulation and compare
s = markov.AnalyticalSimulation(m)
s.set_membrane_potential(V1)
d = s.run(t_pre)
s.set_membrane_potential(V2)
d = s.run(t_step, log=d)

# Plot the analyticaly determined states
for i, state in enumerate(m.states()):
    plt.plot(d.time(), d[state] * N, color=colors[i])

# Show the results
plt.legend(loc='upper left')
plt.show()

