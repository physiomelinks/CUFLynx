tau_s = 85.0 * exp(-pow(V + 25.0, 2.0) / 320.0) + 5.0 / (1.0 + exp((V - 40.0) / 5.0)) + 42.0;

// membrane
i_ion = INa_tot + IK_tot + ICa_tot;
i_stim = 0.0 * amplitude;
amplitude = -30.0;

// nernst
Ca_o = 2.0;
E_Ca = 0.5 * RTF * log(Ca_o / Ca_i);
E_K = RTF * log(K_o / K_i);
E_Ks = RTF * log((K_o + P_kna * Na_o) / (K_i + P_kna * Na_i));
E_Na = RTF * log(Na_o / Na_i);
