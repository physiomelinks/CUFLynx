d_init =  2.87906256205999983e-04;
f_init =  9.89328560287999981e-01;
f2_init =  9.95474890441999993e-01;
fCass_init =  9.99955429597999990e-01;
s_init =  9.63861017995000013e-01;
r_init =  1.03618091196999999e-03;

// calcium
Buf_c = 0.2;
Buf_sr = 10.0;
Buf_ss = 0.4;
diff_Ca_SR = Ca_sr_bufsr * (i_up - (i_rel + i_leak));
diff_Ca_i = Ca_i_bufc * ((i_leak - i_up) * V_sr / V_c + i_xfer - ICa_cyt * Cm / (2.0 * V_c * F));
Ca_i_bufc = 1.0 / (1.0 + Buf_c * K_buf_c / pow(Ca_i + K_buf_c, 2.0));
Ca_sr_bufsr = 1.0 / (1.0 + Buf_sr * K_buf_sr / pow(Ca_SR + K_buf_sr, 2.0));
diff_Ca_ss = Ca_ss_bufss * (-1.0 * i_CaL * Cm / (2.0 * 1.0 * V_ss * F) + i_rel * V_sr / V_ss - i_xfer * V_c / V_ss);
Ca_ss_bufss = 1.0 / (1.0 + Buf_ss * K_buf_ss / pow(Ca_ss + K_buf_ss, 2.0));
EC = 1.5;
ICa_cyt = i_b_Ca + i_p_Ca - 2.0 * i_NaCa;
ICa_tot = ICa_cyt + i_CaL;
K_buf_c = 0.001;
K_buf_sr = 0.3;
K_buf_ss = 0.00025;
K_up = 0.00025;
O = k1 * pow(Ca_ss, 2.0) * R_prime / (k3 + k1 * pow(Ca_ss, 2.0));
diff_R_prime = -k2 * Ca_ss * R_prime + k4 * (1.0 - R_prime);
V_leak = 0.00036;
V_rel = 0.102;
V_sr = 0.001094;
V_ss = 5.468e-05;
V_xfer = 0.0038;
Vmax_up = 0.006375;
i_leak = V_leak * (Ca_SR - Ca_i);
i_rel = V_rel * O * (Ca_SR - Ca_ss);
i_up = Vmax_up / (1.0 + pow(K_up, 2.0) / pow(Ca_i, 2.0));
i_xfer = V_xfer * (Ca_ss - Ca_i);
k1 = k1_prime / kcasr;
k1_prime = 0.15;
k2 = k2_prime * kcasr;
k2_prime = 0.045;
k3 = 0.06;
k4 = 0.005;
kcasr = max_sr - (max_sr - min_sr) / (1.0 + pow(EC / Ca_SR, 2.0));
max_sr = 2.5;
min_sr = 1.0;

// ibca
g_bca = 0.000592;
i_b_Ca = g_bca * (V - E_Ca);

// ibna
g_bna = 0.00029;
i_b_Na = g_bna * (V - E_Na);

// ical
ical_d_alpha_d = 1.4 / (1.0 + exp((-35.0 - V) / 13.0)) + 0.25;
ical_d_beta_d = 1.4 / (1.0 + exp((V + 5.0) / 5.0));
d_inf = 1.0 / (1.0 + exp((-8.0 - V) / 7.5));
gamma_d = 1.0 / (1.0 + exp((50.0 - V) / 20.0));
tau_d = 1.0 * ical_d_alpha_d * ical_d_beta_d + gamma_d;
f_inf = 1.0 / (1.0 + exp((V + 20.0) / 7.0));
tau_f = 1102.5 * exp(-pow(V + 27.0, 2.0) / 225.0) + 200.0 / (1.0 + exp((13.0 - V) / 10.0)) + 180.0 / (1.0 + exp((V + 30.0) / 10.0)) + 20.0;
f2_inf = 0.67 / (1.0 + exp((V + 35.0) / 7.0)) + 0.33;
tau_f2 = 562.0 * exp(-pow(V + 27.0, 2.0) / 240.0) + 31.0 / (1.0 + exp((25.0 - V) / 10.0)) + 80.0 / (1.0 + exp((V + 30.0) / 10.0));
diff_fCass = (fCass_inf_var - fCass) / fCass_tau_fCass;
fCass_inf_var = 0.6 / (1.0 + pow(Ca_ss / 0.05, 2.0)) + 0.4;
fCass_tau_fCass = 80.0 / (1.0 + pow(Ca_ss / 0.05, 2.0)) + 2.0;
g_CaL = 3.98e-05;
i_CaL = ((fabs(V - 15.0) < 1e-06) ? a_1 * (b - Ca_o) / (2.0 * FRT) : numer / denom);
a_1 = g_CaL * d * f * f2 * fCass * 4.0 * FFRT;
b = 0.25 * Ca_ss;
denom = expm1(2.0 * (V - 15.0) * FRT);
numer = a_1 * (V - 15.0) * (b * exp((V - 15.0) * 2.0 * FRT) - Ca_o);

// if
i_f_K = y * g_f_K * (V - E_K);
g_f_K = 0.0234346;
i_f_Na = y * g_f_Na * (V - E_Na);
g_f_Na = 0.0145654;
y_alpha_y = 1.0 * exp(-2.9 - 0.04 * V);
y_beta_y = 1.0 * exp(3.6 + 0.11 * V);
tau_y = 4000.0 / (y_alpha_y + y_beta_y);
y_inf = 1.0 / (1.0 + exp((V + 80.6) / 6.8));

// ik
g_K1 = 0.065;
i_K1 = g_K1 * xK1_inf_var * (V - 8.0 - E_K);
xK1_inf_var = 1.0 / (1.0 + exp(0.1 * (V + 75.44)));

// ikr
Xr1_alpha_xr1 = 450.0 / (1.0 + exp((-45.0 - V) / 10.0));
Xr1_beta_xr1 = 6.0 / (1.0 + exp((V + 30.0) / 11.5));
tau_Xr1 = 1.0 * Xr1_alpha_xr1 * Xr1_beta_xr1;
Xr1_inf = 1.0 / (1.0 + exp((-26.0 - V) / 7.0));
Xr2_alpha_xr2 = 3.0 / (1.0 + exp((-60.0 - V) / 20.0));
Xr2_beta_xr2 = 1.12 / (1.0 + exp((V - 60.0) / 20.0));
tau_Xr2 = 1.0 * Xr2_alpha_xr2 * Xr2_beta_xr2;
