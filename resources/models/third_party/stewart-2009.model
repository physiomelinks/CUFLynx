tau_m = m_alpha * m_beta;

// inaca
i_NaCa = K_NaCa * (exp(g * vfrt_1) * pow(Na_i, 3.0) * Ca_o - exp((g - 1.0) * vfrt_1) * nao3 * Ca_i * i_NaCa_alpha) / (km * (1.0 + K_sat * exp((g - 1.0) * V * FRT)));
K_NaCa = 1000.0;
K_sat = 0.1;
Km_Ca = 1.38;
Km_Nai = 87.5;
i_NaCa_alpha = 2.5;
g = 0.35;
km = (pow(Na_o, 3.0) + pow(Km_Nai, 3.0)) * (Km_Ca + Ca_o);
nao3 = pow(Na_o, 3.0);
vfrt_1 = V * FRT;

// inak
K_mNa = 40.0;
K_mk = 1.0;
P_NaK = 2.724;
i_NaK = P_NaK * K_o / (K_o + K_mk) * Na_i / (Na_i + K_mNa) / (1.0 + 0.1245 * exp(-0.1 * vfrt_2) + 0.0353 * exp(-vfrt_2));
