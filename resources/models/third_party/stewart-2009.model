// ina
g_Na = 130.5744;
h_alpha = ((V < -40.0) ? 0.057 * exp(-(V + 80.0) / 6.8) : 0.0);
h_beta = ((V < -40.0) ? 2.7 * exp(0.079 * V) + 310000.0 * exp(0.3485 * V) : 0.77 / (0.13 * (1.0 + exp((V + 10.66) / -11.1))));
h_inf = 1.0 / pow(1.0 + exp((V + 71.55) / 7.43), 2.0);
