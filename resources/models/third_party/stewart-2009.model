j_beta = ((V < -40.0) ? 0.02424 * exp(-0.01052 * V) / (1.0 + exp(-0.1378 * (V + 40.14))) : 0.6 * exp(0.057 * V) / (1.0 + exp(-0.1 * (V + 32.0))));
j_inf = 1.0 / pow(1.0 + exp((V + 71.55) / 7.43), 2.0);
tau_j = 1.0 / (j_alpha + j_beta);
m_alpha = 1.0 / (1.0 + exp((-60.0 - V) / 5.0));
m_beta = 0.1 / (1.0 + exp((V + 35.0) / 5.0)) + 0.1 / (1.0 + exp((V - 50.0) / 200.0));
