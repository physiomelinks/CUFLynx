R = 8314.472;
RTF = R * T / F;
T = 310.0;
V_c = 0.016404;

// potassium
IK_tot = i_K1 + i_to + i_f_K + i_sus + i_Kr + i_Ks + i_p_K - 2.0 * i_NaK;
diff_K_i = -IK_tot / (V_c * F) * Cm;

// sodium
INa_tot = i_Na + i_b_Na + i_f_Na + 3.0 * i_NaK + 3.0 * i_NaCa;
diff_Na_i = -INa_tot / (V_c * F) * Cm;

// Sum of currents
Iion = i_ion + i_stim;

// Solve non-HH and non-Markov states with CVODE
