[[model]]
name: DN1985
author: Michael Clerx
desc: """
    Di Francesco-Noble Purkinje Fibre Model 1985

    Converted from CellML and annotated. Time units changed to milliseconds.

    --- Original CellML Metadata ---------------------------------------------

    Di Francesco-Noble Purkinje Fibre Model 1985

    Catherine Lloyd
    Bioengineering Institute, University of Auckland

    Model Status:
    This model has been curated and unit-checked by Penny Noble of Oxford
    University and is known to run in PCEnv and COR and reproduce the results
    published in the paper it is based on.

    Model Structure:
    During the years that followed the formulation of the
    McAllister-Noble-Tsien Purkinje fibre model in 1975 and the Beeler-Reuter
    mammalian ventricular model in 1977, many experiments were performed which
    provided a greater insight into the working of the ion channels in cardiac
    tissue. D. Di Francesco and D. Noble (1985) constructed a new model of
    cardiac electrical activity which sought to incorporate much of this new
    data

    The complete original paper reference is cited below:

    A Model of the Cardiac Electrical Activity Incorporating Ionic Pumps and
    Concentration Changes - Simulations of Ionic Currents and Concentration
    Changes,
    Di Francesco, D. and Noble, D.
    Phil. Trans. R. Soc. Lond., B307, 353-398.
    """
# Initial values
membrane.V     = -87
if.y           = 0.2
ik.x           = 0.01
ito.s          = 1
ina.m          = 0.01
ina.h          = 0.8
isi.d          = 0.005
isi.f          = 1
isi.f2         = 1
sodium.Nai     = 8
calcium.p      = 1
calcium.Ca_up  = 2
calcium.Ca_rel = 1
calcium.Cai    = 5e-05
potassium.Kc   = 4
potassium.Ki   = 140

#
# External variables
#
[engine]
time = 0 bind time
pace = 0 bind pace
step = 0 bind time_step

#
# Membrane potential
# Page 359
#
[membrane]
C = 0.0756 [uF]
    desc: """
    Membrane capacitance.
    DiFrancesco & Noble used c = 1.2 [uF/cm^2] and A = 0.063 [cm^2] to arrive
    at a capacitance of C = 0.0756 [uF]
    """
dot(V) = -(i_ion + i_stim + i_diff) / C
    in [mV]
    label membrane_potential
i_ion = if.if + ik.iK + ik1.iK1 + ito.ito + inab.iNab + icab.iCab + inak.ip + inaca.iNaCa + ina.iNa + isi.isi
    in [uA]
i_stim = engine.pace * amplitude
    amplitude = -5
    in [uA]
i_diff = i_diff_normalized * C
    in [uA]
i_diff_normalized = 0 bind diffusion_current
    in [uA/F]

#
# Physical constants
#
[phys]
F = 9.64853399e4 [C/mol]
R = 8314.472 [mJ/mol/K]
T = 310 [K]
RTF = R * T / F
    in [mV]

#
# Cellular dimensions
#
[cell]
pi = 3.14159265359
VCell = pi * radius ^ 2 * length
    in [um^3]
Veratio = 0.1
Vi = VCell * (1 - Veratio)
    in [um^3]
length = 2 [um]
radius = 0.05 [um]

#
# Sodium-Calcium exchanger current, INaCa
# Page 364
#
[inaca]
use membrane.V, phys.RTF
use calcium.Cai, sodium.Nai, ext.Cao, ext.Nao
KNaCa = 2e-5 [uA]
dNaCa = 0.001
gamma = 0.5
iNaCa = KNaCa * (
          exp(gamma * (nNaCa - 2) * V / RTF) * Nai ^ nNaCa * ext.Cao
        - exp((gamma - 1) * (nNaCa - 2) * V / RTF) * Nao ^ nNaCa * Cai
     ) / (
        (1 + dNaCa * (Cai * Nao2 + Cao * Nai ^ nNaCa)) * (1 + Cai / 0.0069))
    in [uA]
    Nao2 = Nao ^ nNaCa
nNaCa = 3

#
# Background Calcium current
# Page 366
#
[icab]
use membrane.V
gCab = 2e-5 [mS]
iCab = gCab * (V - nernst.ECa)
    in [uA]

#
# Fast sodium current
# page 366
#
[ina]
use engine.step as dt
use membrane.V
Emh = phys.RTF * log((ext.Nao + 0.12 * potassium.Kc) / (sodium.Nai + 0.12 * potassium.Ki))
    in [mV]
gNa = .75 [mS]
iNa = gNa * m ^ 3 * h * (V - Emh)
    in [uA]
dot(m) = alpha * (1 - m) - beta * m
    alpha = if(abs(E0) < delta, 2, 0.2 * E0 / (1 - exp(-0.1 * E0)))
        E0 = V + 41 [mV]
        delta = 1e-8 [mV]
        in [mS/uF]
    beta = 8 * exp(-0.056 * (V + 66))
        in [mS/uF]
dot(h) = alpha * (1 - h) - beta * h
    alpha = .02 * exp(-0.125 * (V + 75))
        in [mS/uF]
    beta = 2 / (320 * exp(-0.1 * (V + 75)) + 1)
        in [mS/uF]

#
# Hyperpolarising-activated current, if
# Page 359
#
[if]
use membrane.V
use nernst.EK, nernst.ENa
Kmf = 45 [mmol/L]
gNa = 3e-3 [mS] : Na conductance of if channels
gK  = 3e-3 [mS] : K Conductance of if channels
if = ifNa + ifK
    in [uA]
ifK = y * potassium.Kc / (potassium.Kc + Kmf) * gK * (V - EK)
    in [uA]
ifNa = y * potassium.Kc / (potassium.Kc + Kmf) * gNa * (V - ENa)
    in [uA]
dot(y) = alpha * (1 - y) - beta * y
    alpha = 5e-5 * exp(-0.067 * (V + 52 - 10))
        in [mS/uF]
    beta = if(abs(E0) < delta, 2.5e-3, 1e-3 * E0 / (1 - exp(-0.2 * E0)))
        in [mS/uF]
        E0 = V + 42 [mV]
        delta = 1e-8 [mV]

#
# Intracellular calcium
# Page 370
#
[calcium]
use membrane.V
dot(Ca_rel) = (itr - irel) / (2 * Vrel * phys.F)
    in [mmol/L]
dot(Ca_up) = (iup - itr) / (2 * Vup * phys.F)
    in [mmol/L]
Ca_upmax = 5 [mmol/L]
dot(Cai) = -1 * (
          isi.isiCa
        + icab.iCab
        - 2 * inaca.iNaCa / (inaca.nNaCa - 2)
        - irel
        + iup) / (2 * cell.Vi * phys.F)
    in [mmol/L]
KmCa = 0.001 [mmol/L]
Vrel = cell.Vi * 0.02 [um^3]
Vup = cell.Vi * 0.05 [um^3]
irel = 2e-3 * Vrel * phys.F / (1 * taurel) * Ca_rel * Cai2 / (Cai2 + Km2)
    Cai2 = Cai * Cai
    Km2 = KmCa * KmCa
    in [uA]
itr = 2e-3 * Vrel * phys.F / (1 * taurep) * p * (Ca_up - Ca_rel)
    in [uA]
iup = 2e-3 * cell.Vi * phys.F / (tauup * Ca_upmax) * Cai * (Ca_upmax - Ca_up)
    in [uA]
dot(p) = alpha * (1 - p) - beta * p
    alpha = if(V == -34, 2.5e-3, 6.25e-4 * (V + 34) / (exp((V + 34) / 4) - 1))
        in [mS/uF]
    beta = 5e-3 / (1 + exp((V + 34) / -4))
        in [mS/uF]
taurel = 0.05 [s]
taurep = 2 [s]
tauup = 0.025 [s]

#
# Second inward current, Isi
# Page 367
#
[isi]
use phys.RTF
use membrane.V
use calcium.Cai, potassium.Ki, sodium.Nai
use ext.Cao, ext.Nao, potassium.Kc
dot(d) = alpha * (1 - d) - beta * d
    alpha = if(abs(E0) < delta, 0.12, 3e-2 * E0 / (1 - exp(-1 * E0 / 4)))
        in [mS/uF]
    beta = if(abs(E0) < delta, 0.12, 1.2e-2 * E0 / (exp(E0 / 10) - 1))
        in [mS/uF]
    E0 = V + 19 [mV]
    delta = 1e-7 [mV]
dot(f2) = alpha - f2 * (alpha + beta)
    Kmf2 = 1e-3 [mmol/L]
    alpha = 5e-3 [mS/F]
    beta = calcium.Cai * alpha / Kmf2
        in [mS/F]
dot(f) = alpha * (1 - f) - beta * f
    E0 = V + 34 [mV]
    alpha = if(abs(E0) < delta, 2.5e-2, 6.25e-3 * E0 / (exp(E0 / 4) - 1))
        in [mS/F]
    beta = 5e-2 / (1 + exp(-1 * (V + 34) / 4))
        in [mS/F]
    delta = 1e-7 [mV]
Psi = 1.5e-2
isi = isiCa + isiK + isiNa
    in [uA]
isiCa = if(V == 50, 0,    4 * dff * (Cai * exp(100 / RTF) - Cao * dca) * dcai)
    in [uA]
isiK =  if(V == 50, 0, 0.01 * dff * (Ki  * exp( 50 / RTF) -  Kc * dkn) * dkni)
    in [uA]
isiNa = if(V == 50, 0, 0.01 * dff * (Nai * exp( 50 / RTF) - Nao * dkn) * dkni)
    in [uA]
dff = Psi * (V - 50) * d * f * f2
dkn = exp(-1 * (V - 50) / RTF)
dca = exp(-2 * (V - 50) / RTF)
dkni = 1 / (RTF * (1 - dkn))
dcai = 1 / (RTF * (1 - dca))

#
# Background sodium current
# Page 363
#
[inab]
use membrane.V
gNab = 1.8e-4 [mS]
iNab = gNab * (V - nernst.ENa)
    in [uA]

#
# Sodium potassium pump
# Page 364
#
[inak]
use membrane.V
Ip = .125 [uA]
KmK = 1 [mmol/L]
KmNa = 40 [mmol/L]
ip = Ip * potassium.Kc / (KmK + potassium.Kc) * sodium.Nai / (KmNa + sodium.Nai)
    in [uA]

#
# Time-dependent Potassium current, IK
# Page 360
#
[ik]
use membrane.V
use potassium.Ki, potassium.Kc
dot(x) = alpha * (1 - x) - beta * x
    alpha =   5e-4 * exp(0.0826 * (V + 50)) / (1 + exp(0.057 * (V + 50)))
        in [mS/uF]
    beta  = 1.3e-3 * exp(-0.06 * (V + 20)) / (1 + exp(-0.04 * (V + 20)))
        in [mS/uF]
iK = x * iKmax * (Ki - Kc * exp(-V / phys.RTF)) / 140
    in [uA]
    iKmax = .18 [uA]

#
# Time independent Potassium current, IK1
# Page 361
#
[ik1]
use membrane.V
use potassium.Kc, nernst.EK
KmK1 = 210 [mmol/L]
gK1 = .92 [mS]
iK1 = gK1 * Kc / (Kc + KmK1) * (V - EK) / (1 + exp(2 * (V + 10 - EK) / phys.RTF))
    in [uA]

#
# Transient outward Potassium current, Ito
# Page 362
#
[ito]
use membrane.V
use potassium.Kc, potassium.Ki, calcium.Cai
KmCa = 0.0005 [mmol/L]
Kmto = 10 [mmol/L]
gto = 2.8e-4
ito = (s * gto * x
         * (0.2 + Kc / (Kmto + Kc))
         * Cai / (KmCa + Cai)
         * (Ki * exp(0.5 * V / phys.RTF) - Kc * exp(-0.5 * V / phys.RTF)))
    x = if(V == -10, 5, (V + 10) / (1 - exp(-0.2 * (V + 10))))
    in [uA]
dot(s) = alpha * (1 - s) - beta * s
    alpha = 3.3e-5 * exp(-V / 17)
        in [mS/uF]
    beta = 3.3e-2 / (1 + exp((V + 10) / -8))
        in [mS/uF]

#
# Intracellular Potassium concentrations
# Page 373
#
[potassium]
use cell.Vi
use membrane.V
Kb = 4 [mmol/L] : Bulk Potassium concentration
dot(Ki) = -imK / (cell.Vi * phys.F)
    desc: Intracellular Potassium concentration
    in [mmol/L]
dot(Kc) = (-pf * (Kc - Kb) + 1 * imK / (Ve * phys.F))
    desc: Cleft Potassium concentration
    in [mmol/L]
    Ve = 0.00157 [um^3]
    pf = 0.7 [S/F]
imK = ik1.iK1 + ik.iK + if.ifK + isi.isiK + ito.ito - 2 * inak.ip
    in [uA]

#
# Intracellular Sodium concentrations
# Page 369
#
[sodium]
use membrane.V
use cell.Vi
use inaca.iNaCa, inaca.nNaCa
dot(Nai) = -(ina.iNa + inab.iNab + if.ifNa + isi.isiNa + inak.ip * 3 + iNaCa * nNaCa / (nNaCa - 2)) / (Vi * phys.F)
    in [mmol/L]

#
# Reversal potentials
#
[nernst]
EK = phys.RTF * log(potassium.Kc / potassium.Ki)
    in [mV]
ENa = phys.RTF * log(ext.Nao / sodium.Nai)
    in [mV]
ECa = 0.5 * phys.RTF * log(ext.Cao / calcium.Cai)
    in [mV]

#
# External concentrations
#
[ext]
Cao = 2 [mmol/L]
Nao = 140 [mmol/L]

[[protocol]]
# Level  Start    Length   Period   Multiplier
1        10       0.5      500      0

[[script]]
import myokit
import myokit.lib.plots as mp
import matplotlib.pyplot as plt

#
# This example file creates a "cumulative current plot" for the 1985
# Di Francesco-Noble model. All currents are plotted as areas, layered onto
# each other like sediments. This type of plot can help to pinpoint the
# difference in two models' individual currents, and the difference's effect on
# the whole cell.
#

# Get model, simulate a single beat
m = get_model()
p = get_protocol()
s = myokit.Simulation(m, p)

# Run a simulation
cl = 500
s.pre(20 * cl)
d1 = s.run(cl)

# Run a simulation with lower iK
s.reset()
s.set_constant('ik.iK.iKmax', .09)
s.pre(20 * cl)
d2 = s.run(cl)

# List of currents, ordered to make the plot look good
currents = [
    'inak.ip',
    'ito.ito',
    'ik.iK',
    'ik1.iK1',
    'membrane.i_stim',
    'ina.iNa',
    'isi.isi',
    'inab.iNab',
    'inaca.iNaCa',
    'icab.iCab',
    'if.if',
    ]

# Normalize so that sum is 1
normalize = True

# Create figure
fig = plt.figure()
ax = fig.add_subplot(1, 1, 1)
mp.cumulative_current(d1, currents, ax, normalize=normalize)
ax.set_title('DN1985')

if not normalize:
    # y-axes minimum and maximum
    ylo = -0.08
    yhi =  0.12
    ax.set_ylim(ylo, yhi)

# Format plot and display
ax.legend(loc=(1.05, 0.25))
fig.tight_layout()
fig.subplots_adjust(right=0.8)
plt.show()

