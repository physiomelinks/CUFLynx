/*
This file was generated by Myokit.

desc: The 1977 Beeler Reuter model of the AP in ventricular myocytes.

Implemented in Myokit following the equations found in [1].

[1] Reconstruction of the action potential of ventricular myocardial fibres
    G.W. Beeler and H. Reuter
    1977, The Journal of Physiology
name: Beeler-Reuter-1977

*/

V; .nodal(); .external(Vm);
Iion; .nodal(); .external();

V_init = -84.622;
m_init = 0.01;
h_init = 0.99;
j_init = 0.98;
d_init = 0.003;
f_init = 0.99;
x1_init = 0.0004;
Cai_init = 2e-07;

// ik1
IK1 = 0.35 * (4.0 * (expm1(0.04 * (V + 85.0))) / (exp(0.08 * (V + 53.0)) + exp(0.04 * (V + 53.0))) + 0.2 * (V + 23.0) / (-expm1(-0.04 * (V + 23.0))));

// ina
ENa = 50.0;
INa = (gNaBar * pow(m, 3.0) * h * j + gNaC) * (V - ENa);
gNaBar = 4.0;
gNaC = 0.003;
alpha_h = 0.126 * exp(-0.25 * (V + 77.0));
beta_h = 1.7 / (1.0 + exp(-0.082 * (V + 22.5)));
alpha_j = 0.055 * exp(-0.25 * (V + 78.0)) / (1.0 + exp(-0.2 * (V + 78.0)));
beta_j = 0.3 / (1.0 + exp(-0.1 * (V + 32.0)));
alpha_m = (V + 47.0) / (-expm1(-0.1 * (V + 47.0)));
beta_m = 40.0 * exp(-0.056 * (V + 72.0));

// isi
diff_Cai = -1e-07 * Isi + 0.07 * (1e-07 - Cai);
Es = -82.3 - 13.0287 * log(Cai);
Isi = gsBar * d * f * (V - Es);
alpha_d = 0.095 * exp(-0.01 * (V + -5.0)) / (exp(-0.072 * (V + -5.0)) + 1.0);
beta_d = 0.07 * exp(-0.017 * (V + 44.0)) / (exp(0.05 * (V + 44.0)) + 1.0);
alpha_f = 0.012 * exp(-0.008 * (V + 28.0)) / (exp(0.15 * (V + 28.0)) + 1.0);
beta_f = 0.0065 * exp(-0.02 * (V + 30.0)) / (exp(-0.2 * (V + 30.0)) + 1.0);
gsBar = 0.09;

// ix1
Ix1 = x1 * 0.8 * (expm1(0.04 * (V + 77.0))) / exp(0.04 * (V + 35.0));
alpha_x1 = 0.0005 * exp(0.083 * (V + 50.0)) / (exp(0.057 * (V + 50.0)) + 1.0);
beta_x1 = 0.0013 * exp(-0.06 * (V + 20.0)) / (exp(-0.04 * (V + 333.0)) + 1.0);

// stimulus
IStim = 0.0 * amplitude;
amplitude = 25.0;

// Sum of currents
Iion = IK1 + INa + IStim + Isi + Ix1;

// Solve non-HH and non-Markov states with CVODE
group {
  Cai;
}.method(cvode);

// Trace all currents and state variables
group {
  IK1;
  INa;
  IStim;
  Isi;
  Ix1;
  V;
  m;
  h;
  j;
  d;
  f;
  x1;
  Cai;
}.trace();

// Parameters
group {
  ENa;
  gNaBar;
  gNaC;
  gsBar;
  IStim;
  amplitude;
}.param();

