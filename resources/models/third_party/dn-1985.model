--- Original CellML Metadata ---------------------------------------------

Di Francesco-Noble Purkinje Fibre Model 1985

Catherine Lloyd
Bioengineering Institute, University of Auckland

Model Status:
This model has been curated and unit-checked by Penny Noble of Oxford
University and is known to run in PCEnv and COR and reproduce the results
published in the paper it is based on.

Model Structure:
During the years that followed the formulation of the
McAllister-Noble-Tsien Purkinje fibre model in 1975 and the Beeler-Reuter
mammalian ventricular model in 1977, many experiments were performed which
provided a greater insight into the working of the ion channels in cardiac
tissue. D. Di Francesco and D. Noble (1985) constructed a new model of
cardiac electrical activity which sought to incorporate much of this new
data

The complete original paper reference is cited below:

A Model of the Cardiac Electrical Activity Incorporating Ionic Pumps and
Concentration Changes - Simulations of Ionic Currents and Concentration
Changes,
Di Francesco, D. and Noble, D.
Phil. Trans. R. Soc. Lond., B307, 353-398.
name: DN1985

*/

V; .nodal(); .external(Vm);
Iion; .nodal(); .external();

V_init = -87.0;
y_init = 0.2;
x_1_init = 0.01;
s_init = 1.0;
m_init = 0.01;
h_init = 0.8;
d_init = 0.005;
f_init = 1.0;
f2_init = 1.0;
Nai_init = 8.0;
p_init = 1.0;
Ca_up_init = 2.0;
Ca_rel_init = 1.0;
Cai_init = 5e-05;
Kc_init = 4.0;
Ki_init = 140.0;

// calcium
diff_Ca_rel = (itr - irel) / (2.0 * Vrel * F);
diff_Ca_up = (iup - itr) / (2.0 * Vup * F);
Ca_upmax = 5.0;
diff_Cai = -1.0 * (isiCa + iCab - 2.0 * iNaCa / (nNaCa - 2.0) - irel + iup) / (2.0 * Vi * F);
KmCa_1 = 0.001;
Vrel = Vi * 0.02;
Vup = Vi * 0.05;
irel = 0.002 * Vrel * F / (1.0 * taurel) * Ca_rel * Cai2 / (Cai2 + Km2);
Cai2 = Cai * Cai;
Km2 = KmCa_1 * KmCa_1;
itr = 0.002 * Vrel * F / (1.0 * taurep) * p * (Ca_up - Ca_rel);
iup = 0.002 * Vi * F / (tauup * Ca_upmax) * Cai * (Ca_upmax - Ca_up);
alpha_p = ((V == -34.0) ? 0.0025 : 0.000625 * (V + 34.0) / (expm1((V + 34.0) / 4.0)));
beta_p = 0.005 / (1.0 + exp((V + 34.0) / -4.0));
taurel = 0.05;
taurep = 2.0;
tauup = 0.025;

// cell
VCell = pi * pow(radius, 2.0) * length;
Veratio = 0.1;
Vi = VCell * (1.0 - Veratio);
length = 2.0;
pi = 3.14159265359000006e+00;
radius = 0.05;

// ext
Cao = 2.0;
Nao = 140.0;

// icab
gCab = 2e-05;
iCab = gCab * (V - ECa);

// if
Kmf = 45.0;
gK = 0.003;
gNa_1 = 0.003;
if = ifNa + ifK;
ifK = y * Kc / (Kc + Kmf) * gK * (V - EK);
ifNa = y * Kc / (Kc + Kmf) * gNa_1 * (V - ENa);
alpha_y = 5e-05 * exp(-0.067 * (V + 52.0 - 10.0));
beta_y = ((fabs(E0_1) < delta_1) ? 0.0025 : 0.001 * E0_1 / (-expm1(-0.2 * E0_1)));
E0_1 = V + 42.0;
delta_1 = 1e-08;

// ik
iK = x_1 * iKmax * (Ki - Kc * exp(-V / RTF)) / 140.0;
iKmax = 0.18;
alpha_x_1 = 0.0005 * exp(0.0826 * (V + 50.0)) / (1.0 + exp(0.057 * (V + 50.0)));
beta_x_1 = 0.0013 * exp(-0.06 * (V + 20.0)) / (1.0 + exp(-0.04 * (V + 20.0)));

// ik1
KmK1 = 210.0;
gK1 = 0.92;
iK1 = gK1 * Kc / (Kc + KmK1) * (V - EK) / (1.0 + exp(2.0 * (V + 10.0 - EK) / RTF));

// ina
Emh = RTF * log((Nao + 0.12 * Kc) / (Nai + 0.12 * Ki));
gNa_2 = 0.75;
alpha_h = 0.02 * exp(-0.125 * (V + 75.0));
beta_h = 2.0 / (320.0 * exp(-0.1 * (V + 75.0)) + 1.0);
iNa = gNa_2 * pow(m, 3.0) * h * (V - Emh);
alpha_m = ((fabs(E0_2) < delta_2) ? 2.0 : 0.2 * E0_2 / (-expm1(-0.1 * E0_2)));
E0_2 = V + 41.0;
delta_2 = 1e-08;
beta_m = 8.0 * exp(-0.056 * (V + 66.0));

// inab
gNab = 0.00018;
iNab = gNab * (V - ENa);

// inaca
KNaCa = 2e-05;
dNaCa = 0.001;
gamma = 0.5;
iNaCa = KNaCa * (exp(gamma * (nNaCa - 2.0) * V / RTF) * pow(Nai, nNaCa) * Cao - exp((gamma - 1.0) * (nNaCa - 2.0) * V / RTF) * pow(Nao, nNaCa) * Cai) / ((1.0 + dNaCa * (Cai * Nao2 + Cao * pow(Nai, nNaCa))) * (1.0 + Cai / 0.0069));
Nao2 = pow(Nao, nNaCa);
nNaCa = 3.0;

// inak
Ip = 0.125;
KmK = 1.0;
KmNa = 40.0;
ip = Ip * Kc / (KmK + Kc) * Nai / (KmNa + Nai);

// isi
Psi = 0.015;
E0_3 = V + 19.0;
alpha_d = ((fabs(E0_3) < delta_3) ? 0.12 : 0.03 * E0_3 / (-expm1(-1.0 * E0_3 / 4.0)));
beta_d = ((fabs(E0_3) < delta_3) ? 0.12 : 0.012 * E0_3 / (expm1(E0_3 / 10.0)));
delta_3 = 1e-07;
dca = exp(-2.0 * (V - 50.0) / RTF);
dcai = 1.0 / (RTF * (1.0 - dca));
dff = Psi * (V - 50.0) * d * f * f2;
dkn = exp(-1.0 * (V - 50.0) / RTF);
dkni = 1.0 / (RTF * (1.0 - dkn));
E0_4 = V + 34.0;
alpha_f = ((fabs(E0_4) < delta_4) ? 0.025 : 0.00625 * E0_4 / (expm1(E0_4 / 4.0)));
beta_f = 0.05 / (1.0 + exp(-1.0 * (V + 34.0) / 4.0));
delta_4 = 1e-07;
diff_f2 = f2_alpha - f2 * (f2_alpha + f2_beta);
Kmf2 = 0.001;
f2_alpha = 0.005;
f2_beta = Cai * f2_alpha / Kmf2;
isi = isiCa + isiK + isiNa;
isiCa = ((V == 50.0) ? 0.0 : 4.0 * dff * (Cai * exp(100.0 / RTF) - Cao * dca) * dcai);
isiK = ((V == 50.0) ? 0.0 : 0.01 * dff * (Ki * exp(50.0 / RTF) - Kc * dkn) * dkni);
isiNa = ((V == 50.0) ? 0.0 : 0.01 * dff * (Nai * exp(50.0 / RTF) - Nao * dkn) * dkni);

// ito
KmCa_2 = 0.0005;
Kmto = 10.0;
gto = 0.00028;
ito = s * gto * x_2 * (0.2 + Kc / (Kmto + Kc)) * Cai / (KmCa_2 + Cai) * (Ki * exp(0.5 * V / RTF) - Kc * exp(-0.5 * V / RTF));
x_2 = ((V == -10.0) ? 5.0 : (V + 10.0) / (-expm1(-0.2 * (V + 10.0))));
alpha_s = 3.3e-05 * exp(-V / 17.0);
beta_s = 0.033 / (1.0 + exp((V + 10.0) / -8.0));

// membrane
C = 0.0756;
i_diff = 0.0 * C * 1.32275132275132279e+01;
i_ion = (if + iK + iK1 + ito + iNab + iCab + ip + iNaCa + iNa + isi) * 1.32275132275132279e+01;
i_stim = 0.0 * amplitude * 1.32275132275132279e+01;
amplitude = -5.0;

// nernst
ECa = 0.5 * RTF * log(Cao / Cai);
EK = RTF * log(Kc / Ki);
ENa = RTF * log(Nao / Nai);

// phys
F = 9.64853399000000063e+04;
R = 8314.472;
RTF = R * T / F;
T = 310.0;

// potassium
Kb = 4.0;
diff_Kc = -pf * (Kc - Kb) + 1.0 * imK / (Ve * F);
Ve = 0.00157;
pf = 0.7;
diff_Ki = -imK / (Vi * F);
imK = iK1 + iK + ifK + isiK + ito - 2.0 * ip;

// sodium
diff_Nai = -(iNa + iNab + ifNa + isiNa + ip * 3.0 + iNaCa * nNaCa / (nNaCa - 2.0)) / (Vi * F);

// Sum of currents
Iion = i_diff + i_ion + i_stim;

// Solve non-HH and non-Markov states with CVODE
group {
  f2;
  Nai;
  Ca_up;
  Ca_rel;
  Cai;
  Kc;
  Ki;
}.method(cvode);

// Trace all currents and state variables
group {
  i_diff;
  i_ion;
  i_stim;
  V;
  y;
  x_1;
  s;
  m;
  h;
  d;
  f;
  f2;
  Nai;
  p;
  Ca_up;
  Ca_rel;
  Cai;
  Kc;
  Ki;
}.trace();

